  "description": "Anti-abuse webhook receiver for Remnawave: blocks duplicate trial signups by HWID.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
