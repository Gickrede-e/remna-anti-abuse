PORT=3000
HOST=0.0.0.0
# In Docker: keep as /data (matches the volume mount in docker-compose.yml).
# When running locally without Docker: change to ./data/anti-abuse.sqlite
DB_PATH=/data/anti-abuse.sqlite

REMNAWAVE_BASE_URL=https://panel.example.com
REMNAWAVE_API_TOKEN=replace-with-bearer-token-from-panel

WEBHOOK_SECRET=replace-with-shared-secret
WEBHOOK_TIMESTAMP_TOLERANCE_SEC=300

TRIAL_TAGS=trial,trial7d
DRY_RUN=false

LOG_LEVEL=info
